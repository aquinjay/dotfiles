/* Layout for rofi. Colors come from colors.rasi, generated by matugen from the wallpaper. */
@import "~/.config/rofi/colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            640px;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    10px;
    padding:          14px;
}

mainbox      { spacing: 10px; children: [ inputbar, mode-switcher, listview ]; }
inputbar     { padding: 10px 12px; background-color: @bg-alt; border-radius: 8px; spacing: 10px; children: [ prompt, entry ]; }
prompt       { text-color: @accent-lt; }
entry        { placeholder: "search..."; placeholder-color: @fg-dim; }

mode-switcher { spacing: 8px; }
button        { padding: 6px; border-radius: 6px; text-color: @fg-dim; background-color: @bg-alt; }
button selected { text-color: @on-accent; background-color: @accent; }

listview     { lines: 9; columns: 1; spacing: 4px; scrollbar: false; fixed-height: true; }
element      { padding: 8px 10px; border-radius: 6px; spacing: 10px; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element normal.urgent, element selected.urgent { text-color: @urgent; }
element-icon { size: 24px; }
element-text { text-color: inherit; vertical-align: 0.5; }

message      { padding: 8px; background-color: @bg-alt; border-radius: 6px; }
